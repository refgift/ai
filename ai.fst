BEGIN
	DENOTED QUERY;

	DENOTED T;
	T := "hidali";

	INPUT QUERY;
	INTEGER C;
	C := COUNT QUERY;
	IF C = 0 THEN JUMP OVER;
	IF QUERY ? T THEN BEGIN OUTPUT QUERY; OUTPUT SPACE; OUTPUT "VERY SAME"; OUTPUT NEWLINE; RETURN 0; END 
	IF QUERY ~ T THEN BEGIN OUTPUT QUERY; OUTPUT SPACE; OUTPUT "SAME"; OUTPUT NEWLINE; RETURN 0; END 	

OVER:	RETURN -1;
END
