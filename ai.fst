BEGIN
	DENOTED QUERY;
	DENOTED QUIT;
	DENOTED T;
	DENOTED F;
	

	QUIT := "blank";
	T := "TRUE";
	F := "FALSE";	

	OUTPUT BLANK
	OUTPUT GREEN
	OUTPUT "STARTED"
	OUTPUT NEWLINE;

A:	YIELD ;	
	INPUT QUERY;
	IF QUERY ? T THEN BEGIN OUTPUT "TRUE"; OUTPUT NEWLINE ; GOTO Z; END ;
	IF QUERY ? F THEN BEGIN OUTPUT "FALSE"; OUTPUT NEWLINE END ;
	IF QUERY ? QUIT THEN GOTO Z;
	GOTO A;
Z:	OUTPUT "ENDED";
	OUTPUT NEWLINE;
	OUTPUT CLEAR;
END
